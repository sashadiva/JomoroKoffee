<file path="transaction-service/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model cart_items {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)
  carts      carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "cart_items_ibfk_1")

  @@unique([cart_id, product_id], map: "unique_cart_product")
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique(map: "user_id")
  created_at DateTime     @default(now()) @db.Timestamp(0)
  updated_at DateTime     @default(now()) @db.Timestamp(0)
  cart_items cart_items[]
}

model order_details {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  price      Float
  quantity   Int
  created_at DateTime @default(now()) @db.Timestamp(0)
  orders     orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "order_details_ibfk_1")

  @@index([order_id], map: "order_id")
}

model orders {
  id            Int             @id @default(autoincrement())
  user_id       Int
  created_at    DateTime        @db.DateTime(0)
  updated_at    DateTime        @default(now()) @db.Timestamp(0)
  order_details order_details[]
}
